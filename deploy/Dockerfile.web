# AlphaLens web image — FastAPI process only.
# The worker image (deploy/Dockerfile.worker) extends from this base and
# adds Chromium for PDF rendering. Keeping the web image Chromium-free
# saves ~300 MB on every deploy of the web tier.
# Build context is the repo root so backend/ is reachable.

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      curl \
      build-essential \
      pkg-config \
      libcairo2-dev \
      libgirepository1.0-dev \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ ./

RUN groupadd --system app \
 && useradd --system --gid app --home-dir /app --shell /usr/sbin/nologin app \
 && chown -R app:app /app
USER app

EXPOSE 8001

# Default = web. Worker overrides via compose `command:`.
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8001", "--proxy-headers", "--forwarded-allow-ips", "*", "--workers", "2"]
