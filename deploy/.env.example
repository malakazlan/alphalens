# AlphaLens production env — copy to /opt/alphalens/.env on the server
# (chmod 600, never commit). Filled values must come from your password
# manager / Supabase / Cloudflare dashboard, not from a teammate's laptop.

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# JWT Secret from Supabase → Project Settings → API → JWT Secret.
# When set, backend verifies JWTs locally instead of round-tripping per request.
SUPABASE_JWT_SECRET=

# ── Qdrant Cloud ────────────────────────────────────────────────────────────
QDRANT_URL=
QDRANT_API_KEY=

# ── Upstash Redis (ARQ queue) ───────────────────────────────────────────────
UPSTASH_REDIS_URL=

# ── External APIs ───────────────────────────────────────────────────────────
VISION_AGENT_API_KEY=
OPENAI_API_KEY=
FINNHUB_API_KEY=

# ── Server config ───────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8001
DEBUG=false
# Used for CORS allow-list. Origin must match exactly (no trailing slash).
FRONTEND_URL=https://alphalense.netlify.app

# ── Cloudflare Tunnel ───────────────────────────────────────────────────────
# Token from Zero Trust → Networks → Tunnels → alphalens-prod.
# Consumed by the cloudflared container, not the backend.
CLOUDFLARE_TUNNEL_TOKEN=

# ── Sentry (backend) ────────────────────────────────────────────────────────
# DSN from Sentry → alphalens-backend project → Client Keys.
# Leave blank to disable Sentry entirely (silent no-op).
SENTRY_DSN_BACKEND=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_RELEASE is set by deploy.sh from the current git SHA — do not hard-code.
