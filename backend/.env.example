# Copy this to .env and fill in your values

# Supabase (required for Phase 1)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
# Service role key — bypasses RLS, used by backend for cross-user ops
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# JWT signing secret (HS256) — Dashboard → Project Settings → API → JWT Secret.
# When set, the backend verifies tokens locally instead of round-tripping to
# Supabase Auth on every request (~100-300ms saved per authed call).
SUPABASE_JWT_SECRET=your_jwt_secret_here

# OpenAI (required for Phase 5 — chat, report, finbot)
OPENAI_API_KEY=sk-...

# Landing.AI ADE (required for Phase 3 — document processing)
VISION_AGENT_API_KEY=your_vision_agent_key

# FinBot news (required for Phase 5C — FinBot)
FINNHUB_API_KEY=your_finnhub_key

# FinBot — US macro indicators via FRED. Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_key

# Qdrant Cloud (required for Phase 3 — vector DB)
QDRANT_URL=https://xxxx.qdrant.io
QDRANT_API_KEY=your_qdrant_key

# Upstash Redis / ARQ (required for Phase 3 — task queue)
UPSTASH_REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379

# Server
PORT=8001
DEBUG=true
FRONTEND_URL=http://localhost:3000

# ── Sentry (optional — silent no-op when DSN unset) ─────────────────────────
# DSN from Sentry → Project Settings → Client Keys (DSN). Backend project only.
SENTRY_DSN_BACKEND=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
# Set automatically by deploy.sh from git SHA in production. Leave blank locally.
SENTRY_RELEASE=
