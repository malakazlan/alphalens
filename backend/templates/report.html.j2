<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ doc.company }} — AlphaLens Report</title>
<style>
  /* ── Page geometry ─────────────────────────────────────────────────────── */
  @page {
    size: A4;
    margin: 22mm 18mm 22mm 18mm;
  }
  @page :first { margin: 0; }   /* cover page is full-bleed */

  /* ── Typography ────────────────────────────────────────────────────────── */
  /* No web fonts — keeping the renderer fully offline. The CSS stack below
     resolves to a real font on every Linux/macOS/Windows Chromium build. */
  html, body { background: #ffffff; }
  body {
    font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    color: #0f172a;
    font-size: 11pt;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  h1, h2, h3, h4 { font-weight: 700; color: #0f172a; letter-spacing: -0.012em; }
  h2 { font-size: 18pt; margin: 1.4em 0 0.6em; padding-bottom: 0.3em; border-bottom: 1px solid #e5e7eb; break-after: avoid; }
  h3 { font-size: 13pt; margin: 1.2em 0 0.5em; }
  h4 { font-size: 11.5pt; margin: 1em 0 0.4em; }
  p  { margin: 0.5em 0 0.8em; }
  ul, ol { margin: 0.4em 0 0.9em 1.4em; }
  li { margin-bottom: 0.25em; }

  /* ── Markdown tables ───────────────────────────────────────────────────── */
  table {
    border-collapse: collapse;
    width: 100%;
    margin: 0.8em 0 1.2em;
    font-size: 10.5pt;
    break-inside: avoid;
  }
  th, td {
    padding: 6px 9px;
    border: 1px solid #e5e7eb;
    text-align: left;
    vertical-align: top;
  }
  th { background: #f1f5f9; font-weight: 600; }
  td.num, td:nth-child(n+2) { font-variant-numeric: tabular-nums; }

  /* ── Print hygiene ─────────────────────────────────────────────────────── */
  .section { break-inside: avoid-page; }
  .section + .section { break-before: page; }
  .no-break { break-inside: avoid; }
  blockquote {
    border-left: 3px solid #059669;
    padding: 0.2em 0.9em;
    margin: 0.6em 0;
    color: #334155;
    background: #f8fafc;
  }
  code, pre {
    font-family: "JetBrains Mono", ui-monospace, Menlo, monospace;
    font-size: 10pt;
  }
  pre {
    background: #f8fafc; border: 1px solid #e5e7eb;
    padding: 9px 12px; border-radius: 5px;
    white-space: pre-wrap; word-wrap: break-word;
    break-inside: avoid;
  }

  /* ── Cover page ────────────────────────────────────────────────────────── */
  .cover {
    height: calc(297mm - 0px);   /* full A4 */
    padding: 50mm 22mm 28mm;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 75%, #ecfdf5 100%);
    break-after: page;
  }
  .cover .brand {
    font-family: "JetBrains Mono", ui-monospace, Menlo, monospace;
    font-size: 11pt;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #059669;
    font-weight: 600;
  }
  .cover .brand-dot {
    display: inline-block; width: 7px; height: 7px;
    background: #059669; border-radius: 50%;
    margin-right: 10px; vertical-align: middle;
  }
  .cover .doc-type {
    margin-top: 18mm;
    font-family: "JetBrains Mono", ui-monospace, Menlo, monospace;
    font-size: 10pt;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #64748b;
  }
  .cover h1 {
    font-size: 38pt;
    line-height: 1.04;
    letter-spacing: -0.025em;
    margin: 7mm 0 5mm;
    color: #0f172a;
  }
  .cover h1 em {
    font-style: normal;
    background: linear-gradient(90deg, #059669 0%, #10b981 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .cover .lede {
    font-size: 13pt;
    color: #334155;
    max-width: 140mm;
    line-height: 1.55;
  }
  .cover .meta {
    border-top: 1px solid rgba(15, 23, 42, 0.12);
    padding-top: 6mm;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4mm;
    font-family: "JetBrains Mono", ui-monospace, Menlo, monospace;
    font-size: 9pt;
    color: #475569;
    letter-spacing: 0.04em;
  }
  .cover .meta .k {
    color: #94a3b8;
    text-transform: uppercase;
    font-size: 8pt;
    letter-spacing: 0.10em;
    margin-bottom: 1mm;
  }
  .cover .meta .v { color: #0f172a; font-weight: 600; font-size: 10pt; }

  /* ── Body header (running, page 2+) ────────────────────────────────────── */
  /* We hand-roll a page mini-header at the top of every printable section,
     since print-CSS @page running elements are unevenly supported. The
     real page header/footer comes from Chromium's headerTemplate. */

  .disclaimer {
    margin-top: 8mm;
    padding: 6px 10px;
    background: rgba(217, 119, 6, 0.08);
    border-left: 3px solid #d97706;
    font-size: 9pt;
    color: #78350f;
    line-height: 1.5;
  }

  /* ── Section footers ───────────────────────────────────────────────────── */
  .section-foot {
    margin-top: 10mm;
    padding-top: 4mm;
    border-top: 1px dashed #e5e7eb;
    font-family: "JetBrains Mono", ui-monospace, Menlo, monospace;
    font-size: 8.5pt;
    color: #94a3b8;
    letter-spacing: 0.04em;
    display: flex;
    justify-content: space-between;
  }
</style>
</head>
<body>

  {# ─── Cover page ───────────────────────────────────────────────────── #}
  <div class="cover">
    <div>
      <div class="brand">
        <span class="brand-dot"></span>AlphaLens · {{ report.template_label }}
      </div>
      <div class="doc-type">{{ doc.doc_type }}</div>
      <h1>
        {{ doc.company }}
        {% if doc.fiscal_year %}<br><em>FY {{ doc.fiscal_year }}</em>{% endif %}
      </h1>
      <p class="lede">
        Generated by AlphaLens — analyst-grade financial document review.
        This report was synthesised from the source filing using LLM
        reasoning grounded in retrieved excerpts and structured extract data.
      </p>
    </div>

    <div>
      <div class="meta">
        <div>
          <div class="k">Template</div>
          <div class="v">{{ report.template_label }}</div>
        </div>
        <div>
          <div class="k">Sections</div>
          <div class="v">{{ report.section_count }}</div>
        </div>
        <div>
          <div class="k">Word count</div>
          <div class="v">{{ "{:,}".format(report.word_count) }}</div>
        </div>
        <div>
          <div class="k">Generated</div>
          <div class="v">{{ report.generated_at }}</div>
        </div>
      </div>

      <div class="disclaimer">
        <b>Not investment advice.</b> AlphaLens summarises the source
        document; figures and conclusions should be independently verified
        against the original filing before any decision.
      </div>
    </div>
  </div>

  {# ─── Body ────────────────────────────────────────────────────────── #}
  {% for section in report.sections %}
    <section class="section">
      {# The section markdown already starts with `## Title` so we don't
         double-render the heading. If a section ever ships without its
         own header, the title shows up here as a fallback. #}
      {% if not section.html.startswith('<h2') %}
        <h2>{{ section.title }}</h2>
      {% endif %}
      {{ section.html | safe }}

      <div class="section-foot">
        <span>§ {{ "%02d" % loop.index }} · {{ section.title }}</span>
        <span>{{ section.word_count }} words</span>
      </div>
    </section>
  {% endfor %}

</body>
</html>
